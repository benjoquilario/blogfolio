    "rehype-prism-plus": "^1.6.3",
    "rehype-slug": "^5.1.0",
    "remark": "^15.0.1",
    "remark-external-links": "^9.0.1",
    "remark-gfm": "^3.0.1",
    "remark-unwrap-images": "^3.0.1",
    "resend": "^4.6.0",
    "server-only": "^0.0.1",
    "sharp": "^0.32.4",
    "shiki": "^0.14.4",
    "sugar-high": "^0.9.3",
    "tailwind-merge": "^1.14.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.1.6",
