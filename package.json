    "framer-motion": "^11.5.6",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.522.0",
    "next": "^16.2.4",
    "next-auth": "5.0.0-beta.28",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.2.1",
    "postcss": "^8.5.6",
    "react": "19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.46.2",
    "react-icons": "^5.3.0",
